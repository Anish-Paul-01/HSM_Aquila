      <geometry>
        <mesh filename="package://drone_description/meshes_1/rotor_3.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="prop_3" type="continuous">
    <origin xyz="-0.27133 -0.27051 0.05835" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="rotor_3"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════
       ROTOR 4   joint prop_4, axis -z
       ══════════════════════════════════════════════════════════════ -->
  <link name="rotor_4">
    <inertial>
      <origin xyz="${rotor_4_cx} ${rotor_4_cy} ${rotor_4_cz}" rpy="0 0 0"/>
      <mass value="${rotor_4_mass}"/>
      <inertia
        ixx="${rotor_4_ixx}" ixy="${rotor_4_ixy}" ixz="${rotor_4_ixz}"
