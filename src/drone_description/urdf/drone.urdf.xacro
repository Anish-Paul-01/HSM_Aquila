<?xml version="1.0" encoding="utf-8"?>
<!--
  drone.urdf.xacro
  ══════════════════════════════════════════════════════════════════════════════
  REV02 — converted directly from the SolidWorks URDF exporter output
  (Master_Assembly_REV02_SLDASM.urdf). All inertial values (mass, CoM,
  inertia tensor) and all joint origins/axes are taken VERBATIM from that
  export. Nothing has been rounded, approximated, or renamed.

  This revision differs structurally from the previous drone.urdf.xacro:
    - Rotors are named rotor_1..rotor_4 / prop_1..prop_4 (SolidWorks naming),
      NOT rotor_0..rotor_3 / rotor_N_joint (old PX4-numbering convention).
      Spin axis direction is per-joint, exactly as exported:
        prop_1  axis "0 0 -1"      prop_2  axis "0 0 1"
        prop_3  axis "0 0 1"       prop_4  axis "0 0 -1"
    - Camera and IMU are now modeled as native links in this assembly
      (imu_link, camera_link, rgb_link, mono_right_link, mono_left_link)
      rather than pulled in via oakd_pro.urdf.xacro. That include is NOT
      referenced here — decide whether to keep this inline version or
      switch back to the module include before using this file.
    - height_link replaces the previous lidar_1d rangefinder xacro macro.
    - No collision cylinders, joint dynamics/limits, or <gazebo> material
      tags are present — the SolidWorks export doesn't define them and none
      have been added, to avoid introducing values not present in source.

  Only non-numeric change made during conversion: mesh package path
  rewritten from the exporter's literal
    package://Master Assembly_REV02.SLDASM/meshes/<name>.STL
  (not a valid ROS2 package reference) to
    package://drone_description/meshes/<name>.STL
  ══════════════════════════════════════════════════════════════════════════════
-->
<robot name="Drone_Full_Assembly" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find drone_description)/urdf/drone_gazebo.xacro" />

  <!-- ══════════════════════════════════════════════════════════════
       PROPERTIES — BASE LINK
       ══════════════════════════════════════════════════════════════ -->
  <xacro:property name="base_mass" value="2.9001" />
  <xacro:property name="base_cx"   value="8.4077E-05" />
  <xacro:property name="base_cy"   value="0.0071363" />
  <xacro:property name="base_cz"   value="0.0032466" />
  <xacro:property name="base_ixx"  value="0.0037726" />
  <xacro:property name="base_ixy"  value="6.1155E-08" />
