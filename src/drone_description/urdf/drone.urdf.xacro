    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/rotor_4.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/rotor_4.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="prop_4" type="continuous">
    <origin xyz="-0.27133 0.27076 0.05835" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="rotor_4"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════
       IMU LINK   joint imu_joint (fixed)
       ══════════════════════════════════════════════════════════════ -->
  <link name="imu_link">
    <inertial>
      <origin xyz="${imu_cx} ${imu_cy} ${imu_cz}" rpy="0 0 0"/>
      <mass value="${imu_mass}"/>
      <inertia
        ixx="${imu_ixx}" ixy="${imu_ixy}" ixz="${imu_ixz}"
        iyy="${imu_iyy}" iyz="${imu_iyz}"
        izz="${imu_izz}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/imu_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/imu_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0.027618 0 0.09424" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════
       HEIGHT LINK (rangefinder)   joint height_joint (fixed)
       ══════════════════════════════════════════════════════════════ -->
  <link name="height_link">
    <inertial>
      <origin xyz="${height_cx} ${height_cy} ${height_cz}" rpy="0 0 0"/>
      <mass value="${height_mass}"/>
      <inertia
        ixx="${height_ixx}" ixy="${height_ixy}" ixz="${height_ixz}"
        iyy="${height_iyy}" iyz="${height_iyz}"
        izz="${height_izz}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/height_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.5098 0.023529 0.53333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/height_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="height_joint" type="fixed">
    <origin xyz="0.12185 0 -0.02996" rpy="3.1416 0 0"/>
    <parent link="base_link"/>
    <child  link="height_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════
       CAMERA LINK   joint camera_joint (fixed) — massless reference frame,
       exactly as exported (mass and inertia are all zero in source)
       ══════════════════════════════════════════════════════════════ -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/camera_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/camera_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.15365 0.0019585 -0.056061" rpy="0 1.5708 0"/>
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════
       RGB LINK   joint rgb_joint (fixed), parent camera_link
       ══════════════════════════════════════════════════════════════ -->
  <link name="rgb_link">
    <inertial>
      <origin xyz="${rgb_cx} ${rgb_cy} ${rgb_cz}" rpy="0 0 0"/>
      <mass value="${rgb_mass}"/>
      <inertia
        ixx="${rgb_ixx}" ixy="${rgb_ixy}" ixz="${rgb_ixz}"
