  <!-- ══════════════════════════════════════════════════════════════
       BASE LINK
       ══════════════════════════════════════════════════════════════ -->
  <link name="base_link">
    <inertial>
      <origin xyz="${base_cx} ${base_cy} ${base_cz}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_ixx}" ixy="${base_ixy}" ixz="${base_ixz}"
        iyy="${base_iyy}" iyz="${base_iyz}"
        izz="${base_izz}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- ══════════════════════════════════════════════════════════════
       ROTOR 1   joint prop_1, axis -z
       ══════════════════════════════════════════════════════════════ -->
  <link name="rotor_1">
    <inertial>
      <origin xyz="${rotor_1_cx} ${rotor_1_cy} ${rotor_1_cz}" rpy="0 0 0"/>
      <mass value="${rotor_1_mass}"/>
      <inertia
        ixx="${rotor_1_ixx}" ixy="${rotor_1_ixy}" ixz="${rotor_1_ixz}"
        iyy="${rotor_1_iyy}" iyz="${rotor_1_iyz}"
        izz="${rotor_1_izz}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/rotor_1.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/rotor_1.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="prop_1" type="continuous">
    <origin xyz="0.27145 0.27063 0.05835" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="rotor_1"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════
       ROTOR 2   joint prop_2, axis +z
       ══════════════════════════════════════════════════════════════ -->
  <link name="rotor_2">
    <inertial>
      <origin xyz="${rotor_2_cx} ${rotor_2_cy} ${rotor_2_cz}" rpy="0 0 0"/>
      <mass value="${rotor_2_mass}"/>
      <inertia
        ixx="${rotor_2_ixx}" ixy="${rotor_2_ixy}" ixz="${rotor_2_ixz}"
        iyy="${rotor_2_iyy}" iyz="${rotor_2_iyz}"
        izz="${rotor_2_izz}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/rotor_2.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes_1/rotor_2.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="prop_2" type="continuous">
    <origin xyz="0.27145 -0.27063 0.05835" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="rotor_2"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════
       ROTOR 3   joint prop_3, axis +z
       ══════════════════════════════════════════════════════════════ -->
  <link name="rotor_3">
    <inertial>
      <origin xyz="${rotor_3_cx} ${rotor_3_cy} ${rotor_3_cz}" rpy="0 0 0"/>
      <mass value="${rotor_3_mass}"/>
      <inertia
        ixx="${rotor_3_ixx}" ixy="${rotor_3_ixy}" ixz="${rotor_3_ixz}"
        iyy="${rotor_3_iyy}" iyz="${rotor_3_iyz}"
        izz="${rotor_3_izz}"/>
    </inertial>
    <visual>
