<?xml version="1.0"?>
<model>
  <name>probe_yellow_green</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>HSM Aries</name>
  </author>
  <description>
    Yellow-green cylindrical probe object for ERC-style detection task.
    Dimensions taken directly from the team drawing: 200 mm total length,
    40 mm conical tip (20 mm base diameter), 110 mm cylindrical shaft
    (20 mm diameter), 50 mm cylindrical base (30 mm diameter). Model
    origin is at the center of the base, so a pose z=0 sits flush on
    the ground with the cone pointing straight up.
  </description>
</model>
