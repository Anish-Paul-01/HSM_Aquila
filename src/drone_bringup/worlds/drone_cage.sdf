    <!-- Probe 3 — sector D4 
    <model name="probe_3">
      <static>true</static>
      <pose>-1.25 0.25 0.015 0 1.5708 1.571</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.2</length>
            </cylinder>
          </geometry>
          <material>
