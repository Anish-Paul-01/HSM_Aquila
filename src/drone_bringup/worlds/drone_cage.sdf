            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.2</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>-->

    <!-- Probe 2 — sector C3 
    <model name="probe_2">
      <static>true</static>
      <pose>-0.75 -1.25 0.015 0 1.5708 0.785</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.015</radius>
              <length>0.2</length>
            </cylinder>
          </geometry>
