<?xml version="1.0" encoding="UTF-8"?>
<!--
  drone_cage.sdf
  ══════════════════════════════════════════════════════════════════════════════
  ERC 2026 — Droning Sub-Task Competition Environment
  ══════════════════════════════════════════════════════════════════════════════

  COMPETITION SPECS (from ERC 2026 Rules Rev.2 §7.3.2.2):
  ┌─────────────────────────────────────────────────────────────────────────┐
  │  Cage dimensions    : 10 × 10 × 4 m                                    │
  │  Effective area     : disc with 3 m radius in center of cage           │
  │  Lift-off spot      : 1 × 1 m square at center (0, 0)                 │
  │  Landing target     : disc with 0.5 m radius (randomized each mission) │
  │  ArUco lift-off     : original library ID 101, 15 × 15 cm              │
  │  ArUco landing      : original library ID 102, 15 × 15 cm              │
  │  Probes             : yellow-green aluminium, 200 mm long, 30 mm dia.  │
  │  Mission            : 3 × (takeoff → detect → precision land)          │
  │  Probe bonus        : detect 3 probes per mission (sector-based)        │
  └─────────────────────────────────────────────────────────────────────────┘

  COORDINATE SYSTEM (ENU):
  ┌─────────────────────────────────────────────────────────────────────────┐
  │  Origin (0,0,0) = center of cage floor = lift-off spot center          │
  │  X → East  (right side of cage)                                        │
  │  Y → North (far side of cage)                                          │
  │  Z → Up                                                                │
  │                                                                        │
  │  Cage corners: (±5, ±5, 0) to (±5, ±5, 4)                            │
  │  Competition disc: r = 3 m around origin                               │
  └─────────────────────────────────────────────────────────────────────────┘

  SECTOR GRID (from rules Figure 11):
  ┌─────────────────────────────────────────────────────────────────────────┐
  │  Each sector is 1×1 m. Sectors named A1-A5, B1-B5, C1-C5, D1-D5      │
  │  A sectors: x > 0, y > 0  (northeast quadrant)                        │
  │  B sectors: x > 0, y < 0  (southeast quadrant)                        │
  │  C sectors: x < 0, y < 0  (southwest quadrant)                        │
  │  D sectors: x < 0, y > 0  (northwest quadrant)                        │
  └─────────────────────────────────────────────────────────────────────────┘

  PROBE POSITIONS (3 probes, randomized per rules but fixed here for testing):
  ┌─────────────────────────────────────────────────────────────────────────┐
  │  Probe 1: sector A2 → position (0.25, 0.75, 0.01)                     │
  │  Probe 2: sector C3 → position (-0.75, -1.25, 0.01)                   │
  │  Probe 3: sector D4 → position (-1.25, 0.25, 0.01)                    │
  └─────────────────────────────────────────────────────────────────────────┘

  LANDING TARGET POSITION (mission 1 default, judges randomize each run):
  ┌─────────────────────────────────────────────────────────────────────────┐
  │  Landing spot: (1.5, 1.0) — within 3m radius of origin                │
  └─────────────────────────────────────────────────────────────────────────┘

  USAGE:
  ┌─────────────────────────────────────────────────────────────────────────┐
  │  1. Copy to: ~/PX4-Autopilot/Tools/simulation/gz/worlds/               │
  │  2. In drone_gazebo.launch_px4.py change:                              │
  │       'PX4_GZ_WORLD=default'  →  'PX4_GZ_WORLD=drone_cage'            │
  │  3. Launch normally                                                     │
  └─────────────────────────────────────────────────────────────────────────┘

  AUTHOR  : Hochschule Schmalkalden — ERC 2026 Drone Team
  STACK   : Gazebo Harmonic (v8) | PX4 v1.14+ | ROS2 Humble
-->
<sdf version="1.9">
  <world name="drone_cage">

    <!-- ══════════════════════════════════════════════════════════════
         REQUIRED GAZEBO HARMONIC SYSTEM PLUGINS
         PX4 standalone mode requires ALL five of these.
         Without them: sensors never tick, spawn fails, physics broken.
         ══════════════════════════════════════════════════════════════ -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>  

    <plugin filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer"/>

    <plugin filename="gz-sim-air-pressure-system"
            name="gz::sim::systems::AirPressure"/>

    <!-- ══════════════════════════════════════════════════════════════
         PHYSICS — matches PX4 default world settings exactly
         ══════════════════════════════════════════════════════════════ -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- ══════════════════════════════════════════════════════════════
         SCENE — bright indoor lighting for good camera visibility
         ══════════════════════════════════════════════════════════════ -->
    <scene>
      <grid>false</grid>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.9 0.9 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ══════════════════════════════════════════════════════════════
         GPS / SPHERICAL COORDINATES
         matches PX4 default world — keeps EKF happy
         ══════════════════════════════════════════════════════════════ -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- ══════════════════════════════════════════════════════════════
         LIGHTING — bright overhead lights for indoor cage
         Multiple point lights to eliminate shadows on ArUco markers
         so camera detection is reliable
         ══════════════════════════════════════════════════════════════ -->

    <!-- Main overhead sun -->
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <!-- Corner fill lights — eliminates dark spots in ArUco detection -->
    <light name="light_corner_ne" type="point">
      <pose>4 4 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>0.6</intensity>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <linear>0.1</linear>
        <constant>0.5</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="light_corner_nw" type="point">
      <pose>-4 4 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>0.6</intensity>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <linear>0.1</linear>
        <constant>0.5</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="light_corner_se" type="point">
      <pose>4 -4 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>0.6</intensity>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <linear>0.1</linear>
        <constant>0.5</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="light_corner_sw" type="point">
      <pose>-4 -4 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>0.6</intensity>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <linear>0.1</linear>
        <constant>0.5</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Center overhead — directly illuminates ArUco markers -->
    <light name="light_center" type="point">
      <pose>0 0 3.8 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1.2</intensity>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <linear>0.05</linear>
        <constant>0.3</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- ══════════════════════════════════════════════════════════════
         FLOOR — white/light grey for contrast with ArUco markers
         10×10 m matching cage footprint
         ══════════════════════════════════════════════════════════════ 
    <model name="cage_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>10 10</size></plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr>
              <metal>
                <albedo_map>materials/textures/martian_floor.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model> -->

    <!-- ══════════════════════════════════════════════════════════════
         CAGE WALLS — 4 walls + ceiling, 10×10×4 m
         Semi-transparent so Gazebo GUI view is useful
         Walls act as collision boundaries (safety net simulation)
         ══════════════════════════════════════════════════════════════ -->

    <!-- North wall (Y+5) 
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>10 0.05 4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10 0.05 4</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.8 1.0 0.3</ambient>
            <diffuse>0.6 0.8 1.0 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>-->

    <!-- South wall (Y-5) 
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>10 0.05 4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10 0.05 4</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.8 1.0 0.3</ambient>
            <diffuse>0.6 0.8 1.0 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>-->

    <!-- East wall (X+5) 
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.05 10 4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 10 4</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.8 1.0 0.3</ambient>
            <diffuse>0.6 0.8 1.0 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>-->

    <!-- West wall (X-5) 
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.05 10 4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 10 4</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.8 1.0 0.3</ambient>
            <diffuse>0.6 0.8 1.0 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>-->

    <!-- Ceiling (Z+4) 
    <model name="cage_ceiling">
      <static>true</static>
      <pose>0 0 4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>10 10 0.05</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10 10 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.8 1.0 0.2</ambient>
            <diffuse>0.6 0.8 1.0 0.2</diffuse>
          </material>
        </visual>
      </link>
    </model> -->

    <!-- ══════════════════════════════════════════════════════════════
         COMPETITION AREA MARKER — 3m radius disc outline on floor
         Visual guide for operators, not a collision object
         ══════════════════════════════════════════════════════════════ 
    <model name="competition_area_marker">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>3.0</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.65 0.22 0.12 0.1</ambient>
            <diffuse>0.65 0.22 0.12 0.1</diffuse>
          </material>
        </visual>
      </link>
    </model>-->

    <!-- ══════════════════════════════════════════════════════════════
         LIFT-OFF SPOT — 1×1 m square at origin (0,0)
         Marked with ArUco ID 101 (15×15 cm) in center
         White square + ArUco marker on top
         ══════════════════════════════════════════════════════════════ -->

    <!-- White 1×1m lift-off pad -
    <model name="liftoff_pad">
      <static>true</static>
      <pose>0 0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.0 1.0 0.002</size></box>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>-->

    <!-- ArUco marker ID 101 — lift-off spot (15×15 cm) -->
    <!-- Uses PX4's existing arucotag model as base reference -->
    <!-- Note: In real competition this is ArUco original library ID 101 -->
    <!-- For simulation we use a visual plane with distinctive marking -->
    <model name="aruco_liftoff_101">
      <static>true</static>
      <pose>0 0 0.004 0 0 0</pose>
      <link name="base">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>0.15 0.15</size>
            </plane>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
            <pbr>
              <metal>
                <!-- Uses PX4's existing arucotag PNG — replace with ID 101 PNG -->
                <albedo_map>models://aruco_101/materials/textures/aruco_101.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════
         LANDING TARGET — 0.5m radius disc
         Position: (1.5, 1.0) — within 3m radius (sector A2 area)
         In real competition judges randomize this each mission
         Marked with ArUco ID 102 (15×15 cm)
         ══════════════════════════════════════════════════════════════ -->

    <!-- Orange 0.5m radius landing disc -->
    <model name="landing_target_disc">
      <static>true</static>
      <pose>2.0 -2.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <!-- Bright orange — highly visible from above -->
            <ambient>1.0 0.4 0.0 1</ambient>
            <diffuse>1.0 0.4 0.0 1</diffuse>
            <specular>0.2 0.1 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ArUco marker ID 102 — landing target (15×15 cm) -->
    <model name="aruco_landing_102">
      <static>true</static>
      <pose>2.0 -2.0 0.005 0 0 0</pose> 
      <link name="base">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>0.15 0.15</size>
            </plane>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
            <pbr>
              <metal>
                <!-- Replace with ArUco ID 102 PNG for real detection -->
                <albedo_map>models://aruco_102/materials/textures/aruco_102.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>


        <!-- ══════════════════════════════════════════════════════════════
         Competition Probes (Yellow/Green)
         These are placed on the ground along the flight lines
         ══════════════════════════════════════════════════════════════ -->
    <include>
      <uri>model://probe_yellow_green</uri>
      <name>probe_sector_A1</name>
      <pose>1.45 0.85 0.015 0 1.5708 0</pose>
    </include>
    <include>
      <uri>model://probe_yellow_green</uri>
      <name>probe_sector_B2</name>
      <pose>-1.75 -1.85 0.015 0 1.5708 0</pose>
    </include>
    <include>
      <uri>model://probe_yellow_green</uri>
      <name>probe_sector_C1</name>
      <pose>-1.25 1.35 0.015 0 1.5708 0</pose>
    </include>
    <!--<include>
      <uri>model://probe_yellow_green</uri>
      <name>probe_sector_D3</name>
      <pose>13.5 21.0 0 0 1.5708 0</pose>
    </include>
    <include>
      <uri>model://probe_yellow_green</uri>
      <name>probe_sector_A3</name>
      <pose>0.0 -6.5 0 0 1.5708 0</pose>
    </include>-->

    <!-- ══════════════════════════════════════════════════════════════
         PROBES — 3 yellow-green aluminium cylinders
         Specs: 200mm long, 30mm diameter (from rules §7.3.4.3)
         Scattered within 3m radius for drone to detect

         Probe 1: sector A2  → (0.25,  0.75,  0.01)
         Probe 2: sector C3  → (-0.75, -1.25, 0.01)
         Probe 3: sector D4  → (-1.25,  0.25, 0.01)

         Lying flat on floor (rotated 90° around Y axis)
         ══════════════════════════════════════════════════════════════ -->

    <!-- Probe 1 — sector A2 
    <model name="probe_1">
      <static>true</static>
      Lying flat: rotate 90° around Y so cylinder axis is horizontal 
      <pose>0.25 0.75 0.015 0 1.5708 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              200mm long = 0.2m, 30mm diameter = 0.015m radius 
              <radius>0.015</radius>
              <length>0.2</length>
            </cylinder>
          </geometry>
          <material>
             Yellow-green as per rules §7.3.4.3 
