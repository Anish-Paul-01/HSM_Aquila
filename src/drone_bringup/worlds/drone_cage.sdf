    <!-- ══════════════════════════════════════════════════════════════
         SECTOR GRID LINES — thin lines on floor showing 1×1m sectors
         Visual guide matching Figure 11 from ERC 2026 rules
         Only within 3m radius area
         ══════════════════════════════════════════════════════════════ -->

    <!-- Grid line X=0 (vertical center) -->
    <model name="grid_x0">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.01 6.0 0.001</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 0.5</ambient>
            <diffuse>0.5 0.5 0.5 0.5</diffuse>
          </material>
        </visual>
      </link>
